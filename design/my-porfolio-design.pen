                      "content": "AUG 2021 — FEB 2024"
                    },
                    "SiG50": {
                      "content": "GoTyme Bank (Restaff)"
                    },
                    "kyCyV": {
                      "content": "Senior Android Developer"
                    },
                    "SYIzs": {
                      "content": "• CICO Feature: Cash in/out at convenience stores using map SDK, barcode generation, Firebase remote config\n• Bank Statement: Calendar-based statement requests with Jetpack Compose, Kotlin Multiplatform\n• Profile Feature: Dynamic data-driven UI for account info, transaction limits, settings\n• Automation Testing: First person to replace manual testing in releases — increased stable ratio from 65% to 90%\n• Crashlytic Tracking: Built SDK tracking user behaviors, app state, activity/fragment lifecycle"
                    }
                  }
                },
                {
                  "id": "ImR1p",
                  "type": "ref",
                  "ref": "zJmfl",
                  "width": "fill_container",
                  "name": "tl3",
                  "descendants": {
                    "FxKmY": {
                      "content": "NOV 2017 — JUN 2021"
                    },
                    "SiG50": {
                      "content": "Cyberlogitec Vietnam"
                    },
                    "kyCyV": {
                      "content": "Senior Android Developer"
                    },
                    "SYIzs": {
                      "content": "• Reefer Monitoring: Temperature monitoring for containers on vessels — Kotlin, MVVM, Hilt, Room, Coroutine\n• Cargo Work: Daily task recording app — improved performance, refactored MVC to MVVM\n• VITS: Vehicle inspection & quality tracking at port gates — drew prototypes, defined API contracts\n• Logistic App: Vessel management & merchandise evaluation — defined common functions, drew workflows"
                    }
                  }
                },
                {
                  "id": "6Epii",
                  "type": "ref",
                  "ref": "zJmfl",
